# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=minuteai-dev
DDB_TABLE=minuteai
# Leave empty for real AWS; http://localhost:8000 for DynamoDB Local,
# http://localhost:5001 for the moto mock (`make aws-mock`, no Docker needed)
DDB_ENDPOINT_URL=http://localhost:8000
# Leave empty for real S3; http://localhost:5001 with `make aws-mock`
S3_ENDPOINT_URL=

# LLM — model name selects the provider: claude-* -> Anthropic, gemini-* -> Google
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Gemini 3.x thinks by default; low keeps extraction fast (minimal|low|medium|high|default)
LLM_THINKING=low
# Requests per minute cap; Gemini free tier allows ~5 (0 = unlimited)
LLM_RPM=0

# HuggingFace token for pyannote diarization (accept the model licences first)
HF_TOKEN=

# Optional
WHISPER_MODEL=small
TRANSCRIBE_BACKEND=whisper
GROUNDING_MODE=BALANCED
DATA_DIR=./data
